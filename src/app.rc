            VALUE "Author", "neolxsky"
            VALUE "Comments", "Pack/unpack Minecraft versions with bundled Java runtime; PCL2 compatible"
            VALUE "CompanyName", "neolxsky"
            VALUE "FileDescription", "mcPacker - Minecraft Modpack Packer"
