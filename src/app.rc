            VALUE "InternalName", "mcPacker"
            VALUE "LegalCopyright", "Copyright (C) 2026 neolxsky"
            VALUE "OriginalFilename", "mcPacker.exe"
            VALUE "ProductName", "mcPacker"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
